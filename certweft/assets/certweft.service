[Unit]
Description=Certweft fixed Nginx certificate writer
Requires=certweft-nginx.service
After=certweft-nginx.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=root
UMask=0077
WorkingDirectory=/
ExecStart=/opt/certweft/bin/python -I -m certweft.service /etc/certweft/writer.json
Restart=on-failure
RestartSec=1
RestartPreventExitStatus=73
KillMode=mixed
TimeoutStopSec=8
SendSIGKILL=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/certweft /run/certweft /run/certweft-nginx /var/log/certweft-nginx
InaccessiblePaths=/etc/certweft/provisioner-password
RuntimeDirectory=certweft
RuntimeDirectoryMode=0755
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=

[Install]
WantedBy=multi-user.target
